# The extract profile: `publishing extract` and the pinned markitdown, with no Playwright, no Chromium
# and no fonts. The contract is README "Extract".
#
#   docker build -f Dockerfile.extract -t publishing-extract .
#   docker run --rm --network none --user "$(id -u):$(id -g)" -v "$PWD:/work" publishing-extract report.pdf
#
# The `test` stage runs the extract tests (CI: with no network):
#
#   docker build -f Dockerfile.extract --target test -t publishing-extract-test .
#   docker run --rm --network none publishing-extract-test
#
# Debian (glibc), not Alpine: markitdown needs magika, which needs onnxruntime, and onnxruntime
# publishes no musl wheel (tried: `uv sync --extra extract` on python:3.13-alpine fails with "no
# wheel for the current platform"). The convert profile is the Alpine one.
# Pinned: the base images by digest, markitdown and everything under it by uv.lock.
FROM ghcr.io/astral-sh/uv:0.12.22@sha256:f513a91fc62fe7c17567eee97230dd198e43edb8a9fbecca843714a4358fe1bc AS uv

FROM python:3.13-slim-bookworm@sha256:5024f48ba9441d4b13a95d3945abc6365538e3a31109833367a1923523c6efed AS extract
LABEL org.opencontainers.image.title="publishing-extract" \
      org.opencontainers.image.description="Documents (pdf, docx, pptx, xlsx, html, csv, json, xml, epub) to markdown: publishing's extract profile" \
      org.opencontainers.image.source="https://github.com/witt3rd/publishing" \
      org.opencontainers.image.licenses="MIT"

ENV UV_PYTHON_DOWNLOADS=never UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/publishing/venv \
    PATH=/opt/publishing/venv/bin:$PATH \
    HOME=/tmp

WORKDIR /opt/publishing/src
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN --mount=from=uv,source=/uv,target=/usr/local/bin/uv \
    uv sync --locked --no-dev --extra extract --no-editable \
    && ! python -c "import playwright" 2>/dev/null \
    && rm -rf /opt/publishing/src /tmp/* /root/.cache \
    && chmod -R a+rX /opt/publishing \
    && publishing --version

WORKDIR /work
USER 65532:65532
ENTRYPOINT ["publishing", "extract"]
CMD ["--help"]

# The extract tests in the image they describe.
FROM extract AS test
USER root
WORKDIR /opt/publishing/src
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
COPY tests ./tests
RUN --mount=from=uv,source=/uv,target=/usr/local/bin/uv \
    uv sync --locked --extra extract --no-editable && rm -rf /tmp/* /root/.cache && chmod -R a+rX /opt/publishing
USER 65532:65532
ENTRYPOINT ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider", "tests/test_extract.py"]
CMD []

FROM extract
