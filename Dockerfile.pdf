# The pdf profile: `publishing pdf` (merge, pages, strip) and a pinned pypdf, with no
# Playwright, no Chromium, no PDFium and no fonts. The contract is README "PDF".
#
#   docker build -f Dockerfile.pdf -t publishing-pdf .
#   docker run --rm --network none --user "$(id -u):$(id -g)" -v "$PWD:/work" publishing-pdf merge a.pdf b.pdf -o out.pdf
#
# The `test` stage runs the PDF tests (CI: with no network):
#
#   docker build -f Dockerfile.pdf --target test -t publishing-pdf-test .
#   docker run --rm --network none publishing-pdf-test
#
# Pinned: the base images by digest; pypdf by exact version in pyproject.toml (the `pdf` extra), pure Python (no system libraries).
FROM ghcr.io/astral-sh/uv:0.12.22@sha256:f513a91fc62fe7c17567eee97230dd198e43edb8a9fbecca843714a4358fe1bc AS uv

FROM python:3.13-slim-bookworm@sha256:5024f48ba9441d4b13a95d3945abc6365538e3a31109833367a1923523c6efed AS pdf
LABEL org.opencontainers.image.title="publishing-pdf" \
      org.opencontainers.image.description="PDF merge, page selection and metadata strip through a pinned pypdf: publishing's pdf profile" \
      org.opencontainers.image.source="https://github.com/witt3rd/publishing" \
      org.opencontainers.image.licenses="MIT"

ENV UV_PYTHON_DOWNLOADS=never UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/publishing/venv \
    PATH=/opt/publishing/venv/bin:$PATH \
    HOME=/tmp

WORKDIR /opt/publishing/src
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN --mount=from=uv,source=/uv,target=/usr/local/bin/uv \
    uv sync --locked --no-dev --extra pdf --no-editable \
    && ! python -c "import playwright" 2>/dev/null \
    && ! python -c "import pypdfium2" 2>/dev/null \
    && rm -rf /opt/publishing/src /tmp/* /root/.cache \
    && chmod -R a+rX /opt/publishing \
    && publishing --version

WORKDIR /work
USER 65532:65532
ENTRYPOINT ["publishing", "pdf"]
CMD ["--help"]

# The pdf tests in the image they describe.
FROM pdf AS test
USER root
WORKDIR /opt/publishing/src
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
COPY tests ./tests
RUN --mount=from=uv,source=/uv,target=/usr/local/bin/uv \
    uv sync --locked --extra pdf --no-editable && rm -rf /tmp/* /root/.cache && chmod -R a+rX /opt/publishing
USER 65532:65532
ENTRYPOINT ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider", "tests/test_pdftools.py"]
CMD []

FROM pdf
