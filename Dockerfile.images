# The images profile: `publishing images` (resize, convert, thumbnail, strip) and a pinned Pillow, with no
# Playwright, no Chromium, no ffmpeg and no fonts. The contract is README "Images".
#
#   docker build -f Dockerfile.images -t publishing-images .
#   docker run --rm --network none --user "$(id -u):$(id -g)" -v "$PWD:/work" publishing-images thumbnail in.jpg -o out.png --size 128
#
# The `test` stage runs the images tests and golden fixtures (CI: with no network):
#
#   docker build -f Dockerfile.images --target test -t publishing-images-test .
#   docker run --rm --network none publishing-images-test
#
# Pinned: the base images by digest; Pillow by exact version in pyproject.toml (the `images` extra), with its
# own wheels (no system image libraries).
FROM ghcr.io/astral-sh/uv:0.12.22@sha256:f513a91fc62fe7c17567eee97230dd198e43edb8a9fbecca843714a4358fe1bc AS uv

FROM python:3.13-slim-bookworm@sha256:5024f48ba9441d4b13a95d3945abc6365538e3a31109833367a1923523c6efed AS images
LABEL org.opencontainers.image.title="publishing-images" \
      org.opencontainers.image.description="Image resize, convert, thumbnails and metadata strip through a pinned Pillow: publishing's images profile" \
      org.opencontainers.image.source="https://github.com/witt3rd/publishing" \
      org.opencontainers.image.licenses="MIT"

ENV UV_PYTHON_DOWNLOADS=never UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/publishing/venv \
    PATH=/opt/publishing/venv/bin:$PATH \
    HOME=/tmp

WORKDIR /opt/publishing/src
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN --mount=from=uv,source=/uv,target=/usr/local/bin/uv \
    uv sync --locked --no-dev --extra images --no-editable \
    && ! python -c "import playwright" 2>/dev/null \
    && rm -rf /opt/publishing/src /tmp/* /root/.cache \
    && chmod -R a+rX /opt/publishing \
    && publishing --version

WORKDIR /work
USER 65532:65532
ENTRYPOINT ["publishing", "images"]
CMD ["--help"]

# The images tests in the image they describe.
FROM images AS test
USER root
WORKDIR /opt/publishing/src
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
COPY tests ./tests
RUN --mount=from=uv,source=/uv,target=/usr/local/bin/uv \
    uv sync --locked --extra images --no-editable && rm -rf /tmp/* /root/.cache && chmod -R a+rX /opt/publishing
USER 65532:65532
ENV GOLDEN_PROFILE=images
ENTRYPOINT ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider", "tests/test_images.py", "tests/test_golden.py"]
CMD []

FROM images
