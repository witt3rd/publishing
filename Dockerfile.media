# The media profile: `publishing media` (audio, video, thumbnail, concat) and a pinned ffmpeg, with no
# Playwright, no Chromium and no fonts. The contract is README "Media".
#
#   docker build -f Dockerfile.media -t publishing-media .
#   docker run --rm --network none --user "$(id -u):$(id -g)" -v "$PWD:/work" publishing-media audio in.mp4 -o out.mp3
#
# The `test` stage runs the media tests (CI: with no network):
#
#   docker build -f Dockerfile.media --target test -t publishing-media-test .
#   docker run --rm --network none publishing-media-test
#
# Pinned: the base images by digest. ffmpeg is Debian bookworm's, fixed by the base digest's release
# (the build fails unless it is the 5.1 series, and prints the exact version: `ffmpeg -version`).
FROM ghcr.io/astral-sh/uv:0.12.22@sha256:f513a91fc62fe7c17567eee97230dd198e43edb8a9fbecca843714a4358fe1bc AS uv

FROM python:3.13-slim-bookworm@sha256:5024f48ba9441d4b13a95d3945abc6365538e3a31109833367a1923523c6efed AS media
LABEL org.opencontainers.image.title="publishing-media" \
      org.opencontainers.image.description="Audio and video transcodes, thumbnails and concatenation through a pinned ffmpeg: publishing's media profile" \
      org.opencontainers.image.source="https://github.com/witt3rd/publishing" \
      org.opencontainers.image.licenses="MIT"

ENV UV_PYTHON_DOWNLOADS=never UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/publishing/venv \
    PATH=/opt/publishing/venv/bin:$PATH \
    HOME=/tmp

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && ffmpeg -version | head -1 | grep -q 'version 5\.1' \
    && ffmpeg -version | head -1

WORKDIR /opt/publishing/src
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN --mount=from=uv,source=/uv,target=/usr/local/bin/uv \
    uv sync --locked --no-dev --extra media --no-editable \
    && ! python -c "import playwright" 2>/dev/null \
    && rm -rf /opt/publishing/src /tmp/* /root/.cache \
    && chmod -R a+rX /opt/publishing \
    && publishing --version

WORKDIR /work
USER 65532:65532
ENTRYPOINT ["publishing", "media"]
CMD ["--help"]

# The media tests in the image they describe.
FROM media AS test
USER root
WORKDIR /opt/publishing/src
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
COPY tests ./tests
RUN --mount=from=uv,source=/uv,target=/usr/local/bin/uv \
    uv sync --locked --extra media --no-editable && rm -rf /tmp/* /root/.cache && chmod -R a+rX /opt/publishing
USER 65532:65532
ENTRYPOINT ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider", "tests/test_media.py"]
CMD []

FROM media
